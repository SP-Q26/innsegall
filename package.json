{
  "name": "innsegall",
  "version": "0.4.0-alpha",
  "description": "Innsegall · send the scout · Battle Scout for Macintosh · alpha",
  "type": "module",
  "private": true,
  "bin": {
    "innsegall": "./bin/innsegall.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "run": "node bin/innsegall.mjs run",
    "check": "node bin/innsegall.mjs check",
    "runes": "node bin/innsegall.mjs runes",
    "bootstrap": "node bin/innsegall.mjs bootstrap",
    "pack:macos-installer": "bash scripts/build-macos-installer-app.sh",
    "release:macos-installer": "bash scripts/sign-notarize-macos-installer.sh",
    "doctor": "node bin/innsegall.mjs runes",
    "plan": "node bin/innsegall.mjs plan",
    "test": "node scripts/self-test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "field-report": "node scripts/field-report.mjs",
    "publish:issue-spotlights": "node scripts/publish-issue-spotlights.mjs --from-fixtures",
    "publish:issue-spotlights:dry": "node scripts/publish-issue-spotlights.mjs --from-fixtures --dry-run",
    "publish:issue-spotlights:telemetry": "node scripts/publish-issue-spotlight-pipeline.mjs",
    "publish:issue-spotlights:telemetry:dry": "node scripts/publish-issue-spotlight-pipeline.mjs --dry-run",
    "predeploy": "node scripts/prep-deploy.mjs",
    "preflight": "bash scripts/run-launch-preflight.sh",
    "audit": "node scripts/audit-launch.mjs",
    "audit:swarm": "node scripts/audit-swarm.mjs",
    "audit:brand-stack": "node scripts/audit-brand-stack.mjs",
    "build:competitor-posts": "node scripts/build-competitor-absorption-posts.mjs",
    "audit:discovery": "node scripts/audit-discovery.mjs",
    "diagnose:xano": "node scripts/diagnose-xano-wire.mjs",
    "gate:launch": "node scripts/audit-swarm.mjs && node scripts/smoke-live.mjs --base=https://innsegall.com",
    "export:sample-scout": "node scripts/export-sample-scout.mjs",
    "export:og-png": "node scripts/export-og-png.mjs",
    "sync:blog-brand": "node scripts/sync-blog-brand.mjs",
    "check:git-identity": "node scripts/check-git-identity.mjs",
    "dry-test:license": "node scripts/dry-test-license.mjs",
    "sync-gospel": "node scripts/sync-gospel-web.mjs",
    "sync:battle-scout-sample": "node scripts/sync-battle-scout-sample.mjs",
    "dry-run:lanes": "node scripts/dry-run-lanes.mjs",
    "smoke:live": "node scripts/smoke-live.mjs --base=https://innsegall.com",
    "smoke:xano": "node scripts/smoke-xano.mjs",
    "report:funnel": "node scripts/report-funnel.mjs",
    "audit:stripe-sandbox": "node scripts/audit-stripe-sandbox.mjs",
    "export:stripe-images": "node scripts/export-stripe-product-images.mjs",
    "sync:stripe-images": "node scripts/sync-stripe-product-images.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
